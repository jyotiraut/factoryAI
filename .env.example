# FactoryAI environment configuration
# Copy to .env and adjust. Never commit .env — it is gitignored.
# Precedence: code defaults -> configs/*.yaml -> these environment variables -> CLI flags.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
FACTORYAI_ENV=local                  # local | staging | production
FACTORYAI_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
FACTORYAI_LOG_FORMAT=json            # json | console
FACTORYAI_ACTIVE_CATEGORY=bottle     # any enabled entry in configs/categories/

# ---------------------------------------------------------------------------
# PostgreSQL (Phase 2)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=factoryai
POSTGRES_USER=factoryai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Object storage (Phase 2) — see ADR-0003
# ---------------------------------------------------------------------------
STORAGE_BACKEND=minio                # minio | s3 | azure | gcs | local
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=change-me-locally
STORAGE_REGION=eu-central-1
STORAGE_USE_SSL=false
STORAGE_BUCKET_RAW=factoryai-raw
STORAGE_BUCKET_DATASETS=factoryai-datasets
STORAGE_BUCKET_ARTIFACTS=factoryai-artifacts
STORAGE_BUCKET_HEATMAPS=factoryai-heatmaps
STORAGE_PRESIGN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Ingestion & validation (Phase 3)
# ---------------------------------------------------------------------------
INGEST_MAX_FILE_BYTES=26214400       # 25 MiB
INGEST_ALLOWED_FORMATS=png,jpeg,bmp,tiff
INGEST_ALLOWED_COLOR_MODES=RGB,L,RGBA
INGEST_MIN_RESOLUTION=256x256
INGEST_MAX_RESOLUTION=4096x4096
INGEST_DUPLICATE_HAMMING_THRESHOLD=3 # perceptual-hash distance treated as duplicate

# ---------------------------------------------------------------------------
# MLflow (Phase 5) — see ADR-0004
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=factoryai-bottle
MLFLOW_REGISTRY_NAME=factoryai-patchcore-bottle
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# ---------------------------------------------------------------------------
# Training (Phase 5)
# ---------------------------------------------------------------------------
TRAINING_CONFIG=configs/bottle/patchcore.yaml
TRAINING_SEED=42
TRAINING_DEVICE=auto                 # auto | cpu | cuda
TRAINING_NUM_WORKERS=4

# ---------------------------------------------------------------------------
# Promotion gate (Phase 6)
# ---------------------------------------------------------------------------
PROMOTION_MIN_AUROC=0.95
PROMOTION_IMPROVEMENT_MARGIN=0.005   # candidate must beat production by this much
PROMOTION_MAX_RECALL_REGRESSION=0.01

# ---------------------------------------------------------------------------
# API (Phase 7)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_REQUEST_TIMEOUT_SECONDS=30
API_MAX_BATCH_SIZE=64
API_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth (Phase 8)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Celery / Redis (Phase 9) — see ADR-0005
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_TIME_LIMIT_SECONDS=3600

# ---------------------------------------------------------------------------
# Airflow (Phase 10)
# ---------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-locally

# ---------------------------------------------------------------------------
# Monitoring & drift (Phase 11)
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me-locally
DRIFT_WINDOW_HOURS=24
DRIFT_MIN_SAMPLES=200
DRIFT_DATA_THRESHOLD=0.15
DRIFT_PREDICTION_THRESHOLD=0.10
